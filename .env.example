# ================ 服务基本配置 ================
APP_NAME=raster-agent-server
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_PORT=8080

# ================ 大语言模型环境依赖 ================
# 供 memory 机制中的 extractor（记忆提取）/ compressor（会话压缩）后台任务调用
API_KEY=
BASE_URL=
DEFAULT_MODEL=
PROVIDER=deepseek

# OpenAI-compatible / vLLM models (preferred when using a local Qwen service)
# PROVIDER=vllm
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=EMPTY
# OPENAI_MODEL=qwen3
# OPENAI_MODEL_THINKING=qwen3-thinking

# ================ 数据库（storage 层） ================
DATABASE_URL=postgresql://user:password@localhost:5432/raster_agent

# ================ 搜索工具 ================
TAVILY_API_KEY=

# ================ Elasticsearch（长期记忆向量存储） ================
ES_URL=
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_CERTS=true
ES_MEMORY_INDEX=agent_memories

# ================ Embedding / Reranker（Xinference BGE） ================
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
RERANKER_BASE_URL=
RERANKER_MODEL=bge-reranker-v2-m3

# ================ 记忆管理行为参数 ================
# 压缩触发条件：MEMORY_COMPRESSION_TRIGGER_TYPE 取 messages/tokens/fraction 之一，
# MEMORY_COMPRESSION_TRIGGER_VALUE 是对应阈值（messages/tokens 是绝对数量，
# fraction 是 0~1 的小数）。fraction 需要额外配置 MEMORY_MODEL_MAX_INPUT_TOKENS。
MEMORY_COMPRESSION_TRIGGER_TYPE=messages
MEMORY_COMPRESSION_TRIGGER_VALUE=30
MEMORY_MODEL_MAX_INPUT_TOKENS=32000
MEMORY_KEEP_RECENT=10
MEMORY_RECALL_CANDIDATE_K=20
MEMORY_MAX_RECALL=5
MEMORY_IMPORTANCE_THRESHOLD=5
MEMORY_DUPLICATE_SCORE_THRESHOLD=0.92
MEMORY_CONFLICT_SCORE_THRESHOLD=0.75
MEMORY_LOW_CONFIDENCE_MARGIN=2
MEMORY_MIN_RECALL_SCORE=0.3
MEMORY_MAX_CONTEXT_TOKENS=1000
MEMORY_JOB_MAX_ATTEMPTS=3
MEMORY_EXTRACT_MODEL=
MEMORY_COMPRESS_MODEL=

# ================ 记忆功能开关 ================
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT_ENABLED=true
MEMORY_INJECTION_ENABLED=true
MEMORY_TOOL_ENABLED=true
MEMORY_SENSITIVE_FILTER_ENABLED=true
# 用户画像/时间线（L1/L2）实时更新开关，跟 Facts 提取各自独立控制
MEMORY_PROFILE_UPDATE_ENABLED=true

# ================ Skill 机制 ================
SKILLS_DIRS=skills/core,skills/public
SKILLS_ENABLED=true
SKILL_SCRIPT_TIMEOUT_SECONDS=60
SKILL_SCRIPT_MAX_OUTPUT_BYTES=2097152
SKILL_SCRIPT_MAX_MEMORY_MB=512

# ================ Workspace（虚拟文件系统） ================
WORKSPACE_ROOT=./data/workspaces

# ================ Upload（会话附件上传） ================
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.webp
# .docx/.xlsx/.pdf 是否自动离线转换为 Markdown 供模型 read_file 读取，默认开启
ATTACHMENT_AUTO_CONVERT_DOCUMENTS=true

# ================ Sandbox（沙箱执行） ================
SANDBOX_PROVIDER=local
SANDBOX_COMMAND_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_BYTES=2097152
SANDBOX_MAX_MEMORY_MB=512

# ================ Guardrail（权限控制） ================
GUARDRAIL_ENABLED=true

# ================ 数据库自然语言查询（database 委派） ================
DB_QUERY_API_URL=http://ask-db-service:8084/api/ask-db/unified-query
DB_QUERY_API_TIMEOUT=60.0
ECHART_API_URL=http://192.168.80.60:8888/api/ask-data/echarts/generate
ECHART_API_TIMEOUT=30

# ================ RAG 检索（search_knowledge_base 技能） ================
RAG_API_URL=
RAG_DB_ID=0
RAG_TOP_K=1024
RAG_PAGE=1
RAG_PAGE_SIZE=10
RAG_SCORE_THRESHOLD=0.0
RAG_VECTOR_SIMILARITY_WEIGHT=0.8
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MAX_TOKENS=256
RAG_QUERY_REWRITE_TIMEOUT=15.0
RAG_QUERY_REWRITE_HISTORY_TURNS=3

# ================ Redis（Eval 遥测） ================
# 留空即禁用 Eval 遥测
REDIS_URL=
